# Copy to .env and adjust. All values are optional for local development.

PORT=8787
# Frontend origin(s) allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:8443

# Leave unset to use the embedded PGlite database in ./.data/pglite.
# DATABASE_URL=postgres://user:pass@localhost:5432/pitchlive

# Pull live scores, tables and club details from ESPN's public endpoints.
ESPN_SYNC=true
# Simulated live matches (with the public demo stream) for local development.
DEMO_MATCHES=true

# Enables /api/admin/* (Authorization: Bearer <token>). At least 16 characters.
# ADMIN_TOKEN=

# Mux signed playback for licensed streams.
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=   # base64-encoded PEM from the Mux dashboard
